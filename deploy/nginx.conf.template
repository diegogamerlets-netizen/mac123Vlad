server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # Фото приходят в base64 в теле запроса (до ~10 МБ)
    client_max_body_size 15m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Статику отдаёт nginx напрямую
    location /static/img/ {
        alias /opt/oblik/app/static/img/;
        expires 30d;
        add_header Cache-Control "public";
    }
    location /static/ {
        alias /opt/oblik/app/static/;
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }

    # Скрытые файлы наружу не отдаём никогда
    location ~ /\. { deny all; }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Перезаписываем (а не дописываем) адрес клиента: иначе его можно подделать и обойти лимит генераций
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
