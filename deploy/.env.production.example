# Боевые настройки. На сервере этот файл лежит как /opt/oblik/app/.env (права 600, владелец oblik).
# Секреты вписываете вы или передаёте мне безопасным способом; в чаты и репозитории их не кладите.

HOST=127.0.0.1
PORT=8000
BASE_URL=https://ВАШ-ДОМЕН.ru

# Админка заказов: https://ВАШ-ДОМЕН.ru/admin (логин любой, пароль этот). Сделайте длинный и уникальный.
ADMIN_PASSWORD=

# Создание макетов
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_FRONT_QUALITY=high
GEN_LIMIT_PER_HOUR=8

# Цены
PRICE_ONE_PERSON=5990
PRICE_TWO_PEOPLE=9990
PRICE_STEP=5000
PRICE_GROWTH=19990

# Оплата ЮKassa (сначала ключи тестового магазина, потом боевые)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM=
# YOOKASSA_RECEIPT=0

# Проверка адресов (DaData)
DADATA_TOKEN=

# Доставка СДЭК
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_POSTCODE=
# CDEK_API_URL=https://api.edu.cdek.ru/v2   # тестовая среда; для боевой строку не указывайте
PACKAGE_WEIGHT_G=500
PACKAGE_LENGTH_CM=20
PACKAGE_WIDTH_CM=20
PACKAGE_HEIGHT_CM=25
DELIVERY_EXTRA_RUB=0

# Сколько дней хранить макеты, по которым не оформили заказ
GEN_RETENTION_DAYS=30
