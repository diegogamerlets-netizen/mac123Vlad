# Скопируйте этот файл в .env и заполните. Без ключей сайт работает в демо-режиме.

PORT=8000
# Публичный адрес сайта (нужен для возврата со страницы оплаты). На хостинге: https://ваш-домен.ru
BASE_URL=http://localhost:8000

# Цены, ₽ (доставка не входит, считается отдельно)
PRICE_ONE_PERSON=5990
PRICE_TWO_PEOPLE=9990
# +за каждого следующего человека (с третьего) и за каждый дополнительный элемент
PRICE_STEP=5000
MAX_PEOPLE=6
# «Этапы взросления» — набор из 3 фигурок
PRICE_GROWTH=19990

# --- Проверка адресов (DaData → Подсказки по адресам). Без токена адрес НЕ проверяется ---
DADATA_TOKEN=

# --- Доставка СДЭК (личный кабинет → Интеграция → Ключи API) ---
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Индекс, откуда вы отправляете посылки
CDEK_FROM_POSTCODE=
# Тестовая среда: https://api.edu.cdek.ru/v2   Боевая: https://api.cdek.ru/v2
# CDEK_API_URL=https://api.cdek.ru/v2
# Габариты упаковки: вес в граммах, размеры в см
PACKAGE_WEIGHT_G=500
PACKAGE_LENGTH_CM=20
PACKAGE_WIDTH_CM=20
PACKAGE_HEIGHT_CM=25
# Наценка к тарифу СДЭК (упаковка и т.п.), ₽
DELIVERY_EXTRA_RUB=0
# Цена доставки в демо-режиме, пока нет ключей СДЭК
DELIVERY_FLAT_RUB=500

# Пароль для страницы заказов /admin (логин любой). Пусто — админка выключена.
ADMIN_PASSWORD=

# --- Создание макетов: OpenAI (platform.openai.com → API keys; подписка ChatGPT Plus для API не нужна и не подходит) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# Модель картинок и качество (low / medium / high: чем выше, тем дороже и лучше сходство)
# OPENAI_IMAGE_MODEL=gpt-image-1.5   (gpt-image-2 детальнее, но намного медленнее)
# OPENAI_IMAGE_QUALITY=medium
# Модель-проверяющий: смотрит на результат и ловит тёмные пятна (AI_QA=0 выключает проверку)
# OPENAI_QA_MODEL=gpt-4.1-mini
# Максимум генераций с одного IP в час (защита от лишних трат)
GEN_LIMIT_PER_HOUR=8

# --- ЮKassa (Настройки магазина → Ключи API) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ: код НДС (1 = без НДС) и система налогообложения (1–6), если нужна
YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM=
# Если онлайн-касса в ЮKassa не подключена, поставьте 0
YOOKASSA_RECEIPT=1
